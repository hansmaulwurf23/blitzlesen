<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        app:navigationContentDescription="@string/abort_confirm"
        app:navigationIcon="@drawable/ic_close">

        <TextView
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/time_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:max="1000"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/divider"
        app:trackCornerRadius="8dp"
        app:trackThickness="14dp" />

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <TextView
            android:id="@+id/time_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="@string/time_up"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/word"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textSize="72sp"
                app:autoSizeMaxTextSize="80sp"
                app:autoSizeMinTextSize="32sp"
                app:autoSizeTextType="uniform" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/accent"
            android:textSize="120sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/count_good"
            style="@style/CountChip"
            android:backgroundTint="@color/good"
            android:textColor="#FFFFFFFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/count_practice"
            style="@style/CountChip"
            android:backgroundTint="@color/practice"
            android:textColor="@color/on_practice" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rate_good"
            style="@style/RateButton"
            android:layout_marginEnd="8dp"
            android:text="@string/rate_good"
            android:textColor="#FFFFFFFF"
            app:backgroundTint="@color/good"
            app:icon="@drawable/ic_check"
            app:iconTint="#FFFFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rate_practice"
            style="@style/RateButton"
            android:layout_marginStart="8dp"
            android:text="@string/rate_practice"
            android:textColor="@color/on_practice"
            app:backgroundTint="@color/practice"
            app:icon="@drawable/ic_replay"
            app:iconTint="@color/on_practice" />

    </LinearLayout>

</LinearLayout>
